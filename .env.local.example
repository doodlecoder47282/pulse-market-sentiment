# Charles Schwab API credentials
# 1. Go to https://developer.schwab.com/dashboard/apps
# 2. Create a new app (or use existing), set callback URL to https://127.0.0.1
# 3. Copy Client ID and Client Secret below
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1

# X / Twitter API (optional — enables Voices panel real-time tweets)
# Get from https://developer.twitter.com/en/portal/dashboard
X_BEARER_TOKEN=

# Discord webhooks (optional). Each card is disabled (logged once) when its
# variable is empty. Never commit real webhook URLs: anyone holding one can
# post to the channel. Create or regenerate them in Discord channel settings.
PULSE_DISCORD_WEBHOOK=
PULSE_DISCORD_WHALE_WEBHOOK=
PULSE_DISCORD_UOA_WEBHOOK=
PULSE_DISCORD_ODTE_WEBHOOK=
PULSE_DISCORD_MODEL_WEBHOOK=

# Access key gate. When set, every /api call except /api/health must send
# header x-batcave-key with this value; the web app asks for it once and keeps
# it in this browser only. Use a long random value (32+ characters, e.g.
# `openssl rand -hex 32`); shorter keys log a warning at boot.
# Unset on a loopback bind (127.0.0.1, the local default): /api stays open.
# Unset on a reachable bind (0.0.0.0, Railway/Render/Fly or HOST=0.0.0.0):
# the server FAILS CLOSED and /api returns 503 until the key is set.
BATCAVE_ACCESS_KEY=
# Set to 1 ONLY to run a reachable server with no access key on purpose
# (anyone who can reach it can read data, post to Discord and trigger paid AI
# calls). Leave empty.
BATCAVE_ALLOW_OPEN=
# Extra CORS origins allowed to call /api (comma-separated), e.g. a separately
# hosted UI. The iOS app origins (capacitor://localhost etc.) are built in.
BATCAVE_ALLOWED_ORIGINS=
# Bind address. Default 127.0.0.1; 0.0.0.0 automatically on Railway/Render/Fly.
HOST=

# 0DTE plan ledger (optional, not secrets). Whole contracts the published plan
# is sized and graded with (T1 sells floor(n/2)); empty = reference size 2.
BATCAVE_ODTE_PLAN_CONTRACTS=
# All-in index option (SPXW) fee, $ per contract per side (commission +
# exchange fees, from a trade confirm). Empty = index dollar P&L unavailable and
# the 0DTE alert's ledger line is printed gross of fees.
INDEX_OPTION_FEE_PER_CONTRACT=

# Schwab OAuth tokens at rest (AES-256-GCM). BATCAVE_TOKEN_KEY is exactly 32
# random bytes encoded as base64, not hex: `openssl rand -base64 32`.
#   Set: tokens in data.db are encrypted with it (a plaintext row is encrypted
#        on first read).
#   Unset on 127.0.0.1: a key file is generated once at ~/.batcave/token.key
#        (mode 0600, outside the repo; path: BATCAVE_TOKEN_KEY_FILE) and used.
#   Unset on a reachable bind (0.0.0.0, Railway): token storage is locked
#        (Schwab cannot connect) until it is set. Never commit it.
BATCAVE_TOKEN_KEY=
BATCAVE_TOKEN_KEY_FILE=
# Set to 1 ONLY to store tokens unencrypted on a 127.0.0.1 install. Leave empty.
BATCAVE_TOKEN_PLAINTEXT_OK=
# Rotation only: the previous key, tried for decryption, then re-encrypted
# under BATCAVE_TOKEN_KEY. Remove after one restart.
BATCAVE_TOKEN_KEY_PREVIOUS=
# Reverse-proxy hops to trust for the client IP (X-Forwarded-For). Default:
# 1 on Railway/Render/Fly, 0 elsewhere. Only raise it if more proxies sit in
# front; trusting hops that do not exist lets clients spoof their IP.
BATCAVE_TRUST_PROXY_HOPS=

# SEC EDGAR (optional, free, no key). The SEC fair-access policy requires a
# descriptive User-Agent naming the app and a contact email, e.g.
# "Batcave yourname@yourdomain.com". When empty, the SEC press feed, the
# EDGAR 8-K wire and watchlist filings show "not configured" and are never
# called. https://www.sec.gov/search-filings/edgar-search-assistance/accessing-edgar-data
BATCAVE_SEC_USER_AGENT=

# CoinGecko reference price for BTC/ETH/SOL on the Crypto tab (optional,
# free Demo plan key). The keyless CoinGecko API is documented as not for
# scheduled polling, so without a key the reference shows "not configured";
# Coinbase and Kraken quotes do not need it.
BATCAVE_COINGECKO_DEMO_KEY=

# Schwab streaming (optional, not secrets). Empty = built-in defaults.
# Set to 0 to disable the Schwab streamer and use REST snapshots only.
BATCAVE_STREAM=
# Comma-separated equity symbols streamed as Level 1 quotes (default: $SPX,
# $VIX, $VIX9D, SPY, QQQ, IWM, DIA and the Magnificent 7).
BATCAVE_STREAM_EQUITIES=
# Comma-separated symbols streamed as chart bars (default: SPY,QQQ).
BATCAVE_STREAM_CHARTS=
# Max option symbols streamed at once, integer 0-400 (default 120). Left
# commented out on purpose: an empty value is read as 0, which turns option
# streaming off. Uncomment only with a number.
# BATCAVE_STREAM_MAX_OPTIONS=
