  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "build:ios": "vite build --config vite.native.config.ts --mode native",
    "ios:sync": "vite build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:preflight": "node scripts/ios-preflight.mjs",
    "ios:verify": "bash scripts/ios-verify.sh",
    "ios:run": "npm run ios:sync && cap run ios",
    "test:mobile": "tsx --test tests/mobile.test.ts",
    "test:calculations": "tsx --test tests/calculation-review.test.ts",
    "test:crypto": "tsx --test tests/crypto-reliability.test.ts tests/meme-scoring.test.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "start:isolated": "node script/start-isolated-runtime.mjs",
    "check": "tsc",
    "test:regression": "tsx --test tests/*.test.ts",
    "evidence:history": "tsx scripts/evidence-history.ts",
    "evidence:backup": "tsx scripts/evidence-backup.ts",
    "test:evidence-foundation": "tsx --test tests/evidence-ledger.test.ts tests/evidence-backup.test.ts tests/evidence-acquisition.test.ts tests/evidence-policy.test.ts tests/equity-calendar.test.ts tests/trade-brief.test.ts tests/trade-brief-enrichment.test.ts tests/trade-brief-ai.test.ts",
